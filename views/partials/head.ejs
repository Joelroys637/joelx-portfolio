<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0" name="viewport" />
<link rel="icon" href="/joelx.png" type="image/png" />
<link rel="apple-touch-icon" href="/joelx.png" />

<%
  const currentSeo = (typeof seo !== 'undefined' && seo) ? seo : {};
  const pageTitle = currentSeo.title || "Joelx Orbit | Global Web Service, Mobile App Development, CRM & Desktop Application";
  const pageDescription = currentSeo.description || "Joelx Orbit is a leading global IT service company specializing in top-tier web development, mobile app development (Android & iOS), custom CRM solutions, and robust desktop applications. Transform your business with our tech experts, providing innovative solutions for clients in Vietnam, Poland, Brazil, Mexico, Ukraine, Malaysia, and Singapore.";
  const pageKeywords = currentSeo.keywords || "best IT company, web development, app development, custom CRM web application, billing app, global web service, mobile app development, CRM software development, desktop application development, top IT company, custom software development, Android app development, iOS app development, Joelx Orbit, Vietnam web development, Poland app development, Brazil CRM solutions, Mexico software development, Ukraine IT services, Malaysia web development, Singapore tech experts";
  const pageCanonical = currentSeo.canonicalUrl || "https://joelxorbit.in/";
  const pageOgType = currentSeo.ogType || "website";
  const pageOgImage = currentSeo.ogImage || "https://joelxorbit.in/joelx.png";
  const pageStructuredData = currentSeo.structuredData || null;
%>

<!-- ============================================================
     PRIMARY SEO META TAGS
     ============================================================ -->
<title><%= pageTitle %></title>
<meta name="description" content="<%= pageDescription %>" />
<meta name="keywords" content="<%= pageKeywords %>" />
<meta name="author" content="Joelx Orbit" />
<meta name="google-site-verification" content="5uieVT_Zcf0XzZxJ9rmwJlKvO9L3PPYDgraSarxlq44" />
<meta name="google-adsense-account" content="ca-pub-5342182227761563" />
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5342182227761563" crossorigin="anonymous"></script>
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="theme-color" content="#d2a373" />
<link rel="canonical" href="<%= pageCanonical %>" />

<!-- ============================================================
     OPEN GRAPH (FACEBOOK / LINKEDIN)
     ============================================================ -->
<meta property="og:type" content="<%= pageOgType %>" />
<meta property="og:url" content="<%= pageCanonical %>" />
<meta property="og:title" content="<%= pageTitle %>" />
<meta property="og:description" content="<%= pageDescription %>" />
<meta property="og:image" content="<%= pageOgImage %>" />
<meta property="og:site_name" content="Joelx Orbit" />
<meta property="og:locale" content="en_US" />

<!-- ============================================================
     TWITTER CARD
     ============================================================ -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="<%= pageTitle %>" />
<meta name="twitter:description" content="<%= pageDescription %>" />
<meta name="twitter:image" content="<%= pageOgImage %>" />

<!-- ============================================================
     STRUCTURED DATA (JSON-LD) FOR ADVANCED SEO
     ============================================================ -->
<% if (pageStructuredData) { %>
  <% if (Array.isArray(pageStructuredData)) { %>
    <% pageStructuredData.forEach(function(sd) { %>
      <script type="application/ld+json"><%- JSON.stringify(sd) %></script>
    <% }); %>
  <% } else { %>
    <script type="application/ld+json"><%- JSON.stringify(pageStructuredData) %></script>
  <% } %>
<% } else { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Joelx Orbit",
    "alternateName": ["JoelxOrbit", "Joelx Orbit Web Development"],
    "url": "https://joelxorbit.in/"
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Joelx Orbit",
    "image": "https://joelxorbit.in/joelx.png",
    "@id": "https://joelxorbit.in/",
    "url": "https://joelxorbit.in/",
    "telephone": "+91-9000000000",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Tiruchirappalli",
      "addressRegion": "Tamil Nadu",
      "addressCountry": "IN"
    },
    "description": "A leading global IT service company specializing in web development, mobile app development, CRM, and desktop application development. Providing cutting-edge technology solutions for clients in Vietnam, Poland, Brazil, Mexico, Ukraine, Malaysia, and Singapore.",
    "areaServed": ["Vietnam", "Poland", "Brazil", "Mexico", "Ukraine", "Malaysia", "Singapore", "Global"]
  }
  </script>
<% } %>

