<!-- Chatbot Floating Button -->
<div class="fixed bottom-6 left-12 z-[100]">
  <button type="button" id="chatbot-toggle" aria-label="Open Chatbot" class="bg-gradient-to-br from-[#d2a373] to-[#e6bc98] p-[3px] w-16 h-16 rounded-full shadow-[0_0_20px_rgba(210,163,115,0.5)] hover:scale-110 transition-transform flex items-center justify-center animate-bounce">
    <div class="w-full h-full rounded-full overflow-hidden bg-[#111111]">
      <img src="/chatbot-icon.jpg" alt="Chatbot" class="w-full h-full object-cover" />
    </div>
  </button>
</div>

<!-- Chatbot Window -->
<div id="chatbot-window" class="fixed bottom-24 left-6 md:left-12 w-[calc(100vw-3rem)] md:w-[420px] h-[600px] max-h-[calc(100vh-7rem)] bg-[#111111] border border-white/10 rounded-2xl shadow-2xl flex flex-col overflow-hidden z-[100] transition-all duration-300 origin-bottom-left scale-0 opacity-0 hidden font-body">
  
  <!-- Header -->
  <div class="bg-gradient-to-r from-[#d2a373] to-[#e6bc98] p-4 flex justify-between items-center text-[#0e0e0e]">
    <div class="flex items-center gap-3">
      <img src="/chatbot-icon.jpg" alt="Chatbot" class="w-8 h-8 rounded-full object-cover shadow-sm border border-black/10" />
      <h4 class="font-headline font-bold italic text-lg">Joelx Assistant</h4>
    </div>
    <button type="button" id="chatbot-close" class="hover:bg-black/10 rounded p-1 transition-colors flex items-center">
      <span class="material-symbols-outlined text-sm">close</span>
    </button>
  </div>

  <!-- Chat History -->
  <div id="chatbot-messages" class="flex-1 min-h-0 p-5 overflow-y-auto space-y-5 bg-[#131313] text-sm md:text-base custom-scrollbar">
    <!-- Messages injected here -->
  </div>

  <!-- Input Area -->
  <div class="p-3 border-t border-white/5 bg-[#111111]">
    <form id="chatbot-form" class="flex gap-2">
      <input type="text" id="chatbot-input" class="flex-1 bg-[#1a1a1a] border border-white/10 rounded-full px-4 py-2 text-white placeholder-gray-500 focus:outline-none focus:border-[#d2a373] focus:ring-1 focus:ring-[#d2a373] text-sm transition-colors" placeholder="Type your answer..." autocomplete="off">
      <button type="submit" class="bg-[#d2a373] text-[#0e0e0e] w-10 h-10 shrink-0 rounded-full flex items-center justify-center hover:scale-105 transition-transform disabled:opacity-50">
        <span class="material-symbols-outlined text-sm">send</span>
      </button>
    </form>
  </div>
</div>

<style>
.custom-scrollbar::-webkit-scrollbar {
  width: 4px;
}
.custom-scrollbar::-webkit-scrollbar-track {
  background: transparent;
}
.custom-scrollbar::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4px;
}
.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.2);
}
</style>

<script>
(function() {
    const toggleBtn = document.getElementById('chatbot-toggle');
    const closeBtn = document.getElementById('chatbot-close');
    const windowEl = document.getElementById('chatbot-window');
    const messagesEl = document.getElementById('chatbot-messages');
    const formEl = document.getElementById('chatbot-form');
    const inputEl = document.getElementById('chatbot-input');

    if (!toggleBtn || !windowEl) return;

    let isOpen = false;
    let hasStarted = false;
    let chatState = 'START'; 
    
    const formData = {
      package: 'Custom Quote (Chatbot)',
      price: 'TBD',
      name: '',
      email: '',
      phone: '',
      orgType: '',
      comment: ''
    };

    function addBotMessage(text) {
      const msgDiv = document.createElement('div');
      msgDiv.className = 'flex items-end gap-2 max-w-[85%]';
      msgDiv.innerHTML = `
        <div class="w-8 h-8 rounded-full flex items-center justify-center shrink-0 shadow-sm overflow-hidden border border-white/10 bg-[#1a1a1a]">
          <img src="/chatbot-icon.jpg" alt="Bot" class="w-full h-full object-cover" />
        </div>
        <div class="bg-[#1a1a1a] border border-white/5 rounded-2xl rounded-bl-sm p-3 text-gray-300 leading-relaxed shadow-sm">
          ${text}
        </div>
      `;
      messagesEl.appendChild(msgDiv);
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function addUserMessage(text) {
      const msgDiv = document.createElement('div');
      msgDiv.className = 'flex items-end gap-2 max-w-[85%] ml-auto justify-end';
      msgDiv.innerHTML = `
        <div class="bg-gradient-to-r from-[#2a2a2a] to-[#333333] border border-white/5 text-white rounded-2xl rounded-br-sm p-3 shadow-sm">
          ${text}
        </div>
      `;
      messagesEl.appendChild(msgDiv);
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function initChat() {
      if (!hasStarted) {
        hasStarted = true;
        addBotMessage("Hi! I'm the Joelx Assistant. Ready to start your project?");
        setTimeout(() => {
          addBotMessage("First, what is your **Full Name**?");
          chatState = 'NAME';
          inputEl.focus();
        }, 800);
      } else {
        inputEl.focus();
      }
    }

    toggleBtn.addEventListener('click', (e) => {
      e.preventDefault();
      isOpen = !isOpen;
      if (isOpen) {
        windowEl.classList.remove('hidden');
        setTimeout(() => {
          windowEl.classList.remove('scale-0', 'opacity-0');
          windowEl.classList.add('scale-100', 'opacity-100');
          initChat();
        }, 10);
      } else {
        closeChat();
      }
    });

    closeBtn.addEventListener('click', (e) => {
      e.preventDefault();
      closeChat();
    });

    function closeChat() {
      isOpen = false;
      windowEl.classList.remove('scale-100', 'opacity-100');
      windowEl.classList.add('scale-0', 'opacity-0');
      setTimeout(() => windowEl.classList.add('hidden'), 300);
    }

    formEl.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = inputEl.value.trim();
      if (!val || chatState === 'DONE') return;

      addUserMessage(val);
      inputEl.value = '';

      const nextDelay = 600;

      if (chatState === 'NAME') {
        formData.name = val;
        chatState = 'EMAIL';
        setTimeout(() => addBotMessage(`Nice to meet you, ${val}! What is your **Email Address**?`), nextDelay);
      } 
      else if (chatState === 'EMAIL') {
        if (!val.includes('@') || !val.includes('.')) {
          setTimeout(() => addBotMessage("That doesn't look like a valid email. Please enter a valid **Email Address**."), nextDelay);
          return;
        }
        formData.email = val;
        chatState = 'PHONE';
        setTimeout(() => addBotMessage("Great! And your **Phone Number**?"), nextDelay);
      } 
      else if (chatState === 'PHONE') {
        formData.phone = val;
        chatState = 'ORG';
        setTimeout(() => addBotMessage("Got it. What kind of **Organization** are you from? (e.g. Retail, Healthcare, Startup, Individual)"), nextDelay);
      } 
      else if (chatState === 'ORG') {
        formData.orgType = val;
        chatState = 'COMMENT';
        setTimeout(() => addBotMessage("Lastly, briefly **describe what you need help with** or what project you want to build."), nextDelay);
      } 
      else if (chatState === 'COMMENT') {
        formData.comment = val;
        chatState = 'DONE';
        inputEl.disabled = true;
        inputEl.placeholder = "Sending...";
        setTimeout(() => addBotMessage("Thanks! Sending your inquiry now... 🚀"), nextDelay);
        
        try {
          const response = await fetch('/api/inquiries', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
          });
          
          if (response.ok) {
            setTimeout(() => addBotMessage("✅ All set! We have successfully received your project inquiry and will contact you shortly."), nextDelay + 1000);
            inputEl.placeholder = "Chat finished";
          } else {
            throw new Error('Server returned an error');
          }
        } catch (err) {
          console.error(err);
          setTimeout(() => addBotMessage("❌ Oops, something went wrong while sending. Please try again later or use the regular form."), nextDelay + 1000);
          inputEl.placeholder = "Error sending";
        }
      }
    });

  // Since this script is placed at the end of the HTML structure,
  // the DOM elements are already available. We don't need to wait for DOMContentLoaded.
})();
</script>
