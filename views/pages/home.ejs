            </div>

          </div>

        </div>

      </div>

      <!-- Smooth Transition Wave into Dark Section Below -->
      <div class="absolute bottom-0 left-0 right-0 overflow-hidden leading-none z-10 pointer-events-none">
        <svg class="relative block w-full h-8 sm:h-12 md:h-16 text-[#0e0e0e]" viewBox="0 0 1200 120"
