                <span class="material-symbols-outlined text-lg">lightbulb</span>
              </div>
              <div>
                <div class="text-[11px] font-bold text-slate-800 leading-tight">Innovative UI</div>
                <div class="text-[9px] text-slate-500">Modern Aesthetic</div>
              </div>
            </div>

            <!-- Floating Modern Badge 2: Bottom Right -->
