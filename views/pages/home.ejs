<!DOCTYPE html>

<html class="dark" lang="en">

<head>
  <%- include('../partials/head') %>
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://unpkg.com/swiper@11.0.5/swiper-bundle.min.css" />
    <style>
      .productSwiper {
        width: 100%;
        padding-top: 50px;
        padding-bottom: 70px;
        overflow: visible;
      }

      .productSwiper .swiper-slide {
        width: 320px;
        height: 480px;
        transition: all 0.3s ease;
        background-position: center;
        background-size: cover;
      }

      @media (min-width: 768px) {
        .productSwiper .swiper-slide {
          width: 380px;
          height: 520px;
        }
      }

      .productSwiper .swiper-slide-active {
        filter: drop-shadow(0 20px 40px rgba(249, 197, 145, 0.15));
      }

      .productSwiper .swiper-pagination-bullet {
        background: rgba(255, 255, 255, 0.4);
      }

      .productSwiper .swiper-pagination-bullet-active {
        background: #f9c591;
      }

      /* Dim inactive slides slightly for more focus on center */
      .productSwiper .swiper-slide:not(.swiper-slide-active) {
        opacity: 0.6;
      }
    </style>
</head>

<body class="bg-[#0e0e0e] text-white font-body selection:bg-primary/30 selection:text-primary overflow-x-hidden">

  <%- include('../partials/header') %>

    <!-- ============================================================
       FULL-WIDTH HERO HEADER SECTION (UI MATCHING REFERENCE)
       ============================================================ -->
    <header id="home-hero"
      class="relative w-full bg-white text-slate-900 pt-24 sm:pt-28 md:pt-32 pb-20 md:pb-28 overflow-hidden border-b border-slate-100 select-none">

      <!-- Top-Right Purple / Violet Fluid Wave (From Reference UI) -->
      <div
        class="absolute -top-10 -right-10 md:-top-16 md:-right-16 w-[70vw] sm:w-[55vw] md:w-[48vw] max-w-[800px] aspect-[4/3] pointer-events-none z-0">
        <svg class="w-full h-full" viewBox="0 0 600 480" fill="none" xmlns="http://www.w3.org/2000/svg"
          preserveAspectRatio="none">
          <path d="M160,0 C220,130 300,190 420,230 C510,260 560,330 600,430 L600,0 Z" fill="url(#purpleWaveGrad)" />
          <defs>
            <linearGradient id="purpleWaveGrad" x1="200" y1="0" x2="600" y2="400" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#8b5cf6" />
              <stop offset="45%" stop-color="#7c3aed" />
              <stop offset="100%" stop-color="#6d28d9" />
            </linearGradient>
          </defs>
        </svg>
      </div>

      <!-- Soft Ambient Radial Glows -->
      <div
        class="absolute -top-20 -right-20 w-[420px] h-[420px] bg-purple-500/15 rounded-full blur-3xl pointer-events-none">
      </div>
      <div
        class="absolute top-1/2 right-1/4 w-[350px] h-[350px] bg-cyan-400/15 rounded-full blur-3xl pointer-events-none">
      </div>

      <!-- Bottom Cyan / Turquoise Fluid Curved Wave (From Reference UI) -->
      <div class="absolute bottom-0 right-0 left-0 w-full h-24 sm:h-32 md:h-40 pointer-events-none z-0 overflow-hidden">
        <svg class="w-full h-full" viewBox="0 0 1440 160" fill="none" xmlns="http://www.w3.org/2000/svg"
          preserveAspectRatio="none">
          <path d="M220,160 C420,80 620,120 860,60 C1080,5 1280,70 1440,30 L1440,160 L220,160 Z"
            fill="url(#cyanWaveGrad)" />
          <defs>
            <linearGradient id="cyanWaveGrad" x1="220" y1="160" x2="1440" y2="30" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.18" />
              <stop offset="50%" stop-color="#22d3ee" stop-opacity="0.25" />
              <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.32" />
            </linearGradient>
          </defs>
        </svg>
      </div>

      <!-- Hero Content Container -->
      <div
        class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">

        <!-- Left Column: Modern Headline & CTAs -->
