            class="pt-4 flex flex-wrap items-center gap-6 text-xs text-slate-500 font-medium border-t border-slate-100">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-cyan-600 text-base">verified</span>
              <span>Production Ready</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-indigo-600 text-base">speed</span>
              <span>Fast Performance</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-emerald-600 text-base">devices</span>
              <span>Responsive UI/UX</span>
            </div>
          </div>

        </div>

        <!-- Right Column: Featured Illustration (Uploaded by User) -->
