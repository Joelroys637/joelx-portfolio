        <script>
          document.addEventListener('DOMContentLoaded', () => {
            const exchangeRates = {
              'INR': { rate: 1, symbol: '₹', isINR: true },
              'USD': { rate: 1 / 84, symbol: '$' },
              'EUR': { rate: 1 / 91, symbol: '€' },
              'GBP': { rate: 1 / 108, symbol: '£' },
              'AED': { rate: 1 / 22.8, symbol: 'AED ' },
              'SGD': { rate: 1 / 63, symbol: 'S$' },
              'MYR': { rate: 1 / 19, symbol: 'RM' },
              'VND': { rate: 300, symbol: '₫' },
              'PLN': { rate: 1 / 21, symbol: 'zł' },
              'BRL': { rate: 1 / 15, symbol: 'R$' },
              'MXN': { rate: 1 / 4.6, symbol: '$' },
              'UAH': { rate: 1 / 2, symbol: '₴' }
            };

            const currencySelector = document.getElementById('currencySelector');
            const priceElements = document.querySelectorAll('.price-value');

            if (currencySelector) {
              currencySelector.addEventListener('change', (e) => {
                const selectedCurrency = e.target.value;
                const { rate, symbol, isINR } = exchangeRates[selectedCurrency] || { rate: 1, symbol: '₹', isINR: true };

                priceElements.forEach(el => {
                  const basePrice = parseFloat(el.getAttribute('data-base-price'));
                  if (isINR) {
                    el.textContent = `${symbol}${basePrice.toLocaleString('en-IN')}`;
                  } else {
                    const convertedPrice = Math.round(basePrice * rate);
                    el.textContent = `${symbol}${convertedPrice.toLocaleString()}`;
                  }
                });
              });
            }

            window.getCurrentCurrencyInfo = function () {
              const selectedCurrency = currencySelector ? currencySelector.value : 'INR';
              return exchangeRates[selectedCurrency] || { rate: 1, symbol: '₹', isINR: true };
            };
          });

          window.openDynamicModal = function (pkg, basePrice) {
            let finalPrice = `₹${Number(basePrice).toLocaleString('en-IN')}`;
            if (window.getCurrentCurrencyInfo) {
              const { rate, symbol, isINR } = window.getCurrentCurrencyInfo();
              if (isINR) {
                finalPrice = `${symbol}${Number(basePrice).toLocaleString('en-IN')}`;
              } else {
                const converted = Math.round(basePrice * rate);
                finalPrice = `${symbol}${converted.toLocaleString()}`;
              }
            }
            if (typeof openGetInTouchModal === 'function') {
              openGetInTouchModal(pkg, finalPrice);
            }
          };
        </script>
