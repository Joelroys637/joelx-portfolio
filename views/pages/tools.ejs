  <!-- Interactive QR Code Generation Script -->
  <script>
    let qrInstance = null;

    function renderQR() {
      const container = document.getElementById("qrcode-canvas-container");
      const text = document.getElementById("qr-input").value.trim() || "https://joelxorbit.in";
      const size = parseInt(document.getElementById("qr-size").value) || 300;
      const eccLevel = document.getElementById("qr-ecc").value || "H";

      container.innerHTML = "";

      let correctLevel = QRCode.CorrectLevel.H;
      if (eccLevel === "M") correctLevel = QRCode.CorrectLevel.M;
      if (eccLevel === "Q") correctLevel = QRCode.CorrectLevel.Q;

      qrInstance = new QRCode(container, {
        text: text,
        width: size,
        height: size,
        colorDark: "#0e0e0e",
        colorLight: "#ffffff",
        correctLevel: correctLevel
      });
    }

    document.getElementById("qr-generate-btn")?.addEventListener("click", renderQR);
    document.getElementById("qr-input")?.addEventListener("keypress", function(e) {
      if (e.key === "Enter") renderQR();
    });

    document.getElementById("qr-download-btn")?.addEventListener("click", function() {
      const img = document.querySelector("#qrcode-canvas-container img");
      const canvas = document.querySelector("#qrcode-canvas-container canvas");
      let dataUrl = "";
      if (img && img.src) {
        dataUrl = img.src;
      } else if (canvas) {
        dataUrl = canvas.toDataURL("image/png");
      }

      if (dataUrl) {
        const a = document.createElement("a");
        a.href = dataUrl;
        a.download = "joelxorbit-qrcode.png";
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      }
    });

    // Initial render on load
    window.addEventListener("DOMContentLoaded", renderQR);
  </script>

